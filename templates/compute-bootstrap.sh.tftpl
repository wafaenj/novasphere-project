
#!/bin/bash
set -e
dnf install -y httpd awscli
SECRET=$(aws ssm get-parameter --name "/novasphere/${environment}/db_password" --with-decryption --query "Parameter.Value" --output text --region "${region}")
test -n "$SECRET"
unset SECRET
echo "<h1>NovaSphere - ${environment}</h1><p>Application disponible</p>" > /var/www/html/index.html
systemctl enable --now httpd
